            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n\n  \"model\": \"llama3-8b-8192\",\n\n  \"messages\": [\n\n    {\n\n      \"role\": \"system\",\n\n      \"content\": \"You are an expert executive assistant AI that classifies emails for business professionals. You analyze emails and return structured JSON responses for automated processing. Be precise, consistent, and professional in your classifications.\"\n\n    },\n\n    {\n\n      \"role\": \"user\", \n\n      \"content\": \"Analyze this email and classify it for an executive assistant workflow:\\n\\n**EMAIL DETAILS:**\\nSubject: {{$json.subject}}\\nFrom: {{$json.sender_name}} <{{$json.sender_email}}>\\nBody: {{$json.body}}\\nGmail Labels: {{$json.label_names}}\\nUrgency Keywords Found: {{$json.urgency_indicators}}\\nMarked Important: {{$json.is_important}}\\n\\n**CLASSIFICATION TASK:**\\nReturn a JSON response with this exact structure:\\n\\n{\\n  \\\"action\\\": \\\"use_existing\\\",\\n  \\\"label\\\": \\\"folder_name\\\",\\n  \\\"reasoning\\\": \\\"brief explanation of classification decision\\\",\\n  \\\"contains_question\\\": true/false,\\n  \\\"urgency\\\": \\\"high/medium/low\\\",\\n  \\\"project\\\": \\\"detected project name or null\\\",\\n  \\\"confidence\\\": 0.85,\\n  \\\"suggested_priority\\\": \\\"immediate/today/this_week/normal\\\"\\n}\\n\\n**AVAILABLE FOLDERS:**\\n- Urgent: Time-sensitive items requiring immediate attention\\n- Projects: Project-related communications and updates\\n- Admin: Administrative tasks, HR, policies, general business\\n- Clients: Client communications, support, relationships\\n- Personal: Personal emails that reached business inbox\\n- Follow-up: Items requiring follow-up action or tracking\\n\\n**CLASSIFICATION GUIDELINES:**\\n1. Urgency Assessment: Consider deadline words (urgent, ASAP, tomorrow, today, deadline)\\n2. Question Detection: Look for question marks, requests for information, or implied questions\\n3. Project Detection: Identify specific project names, initiatives, or ongoing work\\n4. Context Clues: Use sender reputation, subject patterns, and content themes\\n5. Confidence Scoring: Rate 0.0-1.0 based on clarity of classification signals\\n\\nRespond ONLY with valid JSON - no additional text or formatting.\"\n\n    }\n\n  ],\n\n  \"temperature\": 0.1,\n\n  \"max_tokens\": 300,\n\n  \"top_p\": 1,\n\n  \"frequency_penalty\": 0,\n\n  \"presence_penalty\": 0\n\n}",
        "options": {}
      },
